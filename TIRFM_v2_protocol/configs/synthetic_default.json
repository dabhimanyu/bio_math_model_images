{
  "io": {
    "mode": "synthetic",
    "input_path": "/Users/abhimanyudubey/MATLAB-Drive/CRAP/bio_math_model_images/TIRFM_v2_protocol/demos/synthetic_demo",
    "file_glob": "*.tif",
    "output_root": "/Users/abhimanyudubey/MATLAB-Drive/CRAP/bio_math_model_images/TIRFM_v2_protocol/outputs",
    "run_id": "synthetic_demo_01",
    "random_seed": 0
  },

  "pilot": { "enabled": true, "num_frames": 2, "exit_after": false },

  "preprocess": {
    "enabled": true,
    "wiener":  { "enabled": true, "window": 5 },
    "median":  { "enabled": true, "window": 2 },
    "sharpen": { "enabled": false, "radius": 1.05, "amount": 1.6, "threshold": 0.7 }
  },

  "masking": {
    "enabled": true,
    "mode": "block_otsu",
    "global_otsu": { "enabled": false },
    "block_otsu":  { "enabled": true, "block_size": 64, "border_size": 8, "use_parallel": true },
    "bradley_adaptive": { "enabled": false, "window_size": 63, "sensitivity": 0.30 },
    "morphology": { "se_type": "disk", "close_radius": 16, "dilate_radius": 3, "open_radius": 2 }
  },

  "regional_max": { "enabled": true, "connectivity": 4 },
  "components":   { "enabled": true, "connectivity": 4 },

  "subpixel": { "enabled": false, "method": "2d_gaussian" },

  "tracking": {
    "enabled": false,
    "max_disp": 4.9,
    "skip_frames": 1,
    "remove_nearby_particles": { "enabled": false, "percent_of_max_pixel_displacement": 105 },
    "carry_intensity": true,
    "export_csv": true,
    "export_mat": false
  },

  "intensity": { "enabled": true, "estimator": "mean_5px_cross", "normalize_per_track": false },

  "outputs": {
    "export_centroids_mat": true,
    "export_detection_csv": true,
    "export_figures": true,
    "save_intermediates": false
  }
}
