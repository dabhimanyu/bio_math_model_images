{
  "io": {
    "mode": "tirf",
    "input_path": "/Users/abhimanyudubey/MATLAB-Drive/CRAP/bio_math_model_images/TIRFM_v2_protocol/demos/tirf_demo",
    "file_glob": "*.png",
    "output_root": "/Users/abhimanyudubey/MATLAB-Drive/CRAP/bio_math_model_images/TIRFM_v2_protocol/outputs",
    "run_id": "Run_001",
    "random_seed": 0
  },
  "pilot": {
    "enabled": true,
    "num_frames": 2,
    "exit_after": false
  },
  "pre_mask_preprocess": {
    "enabled": true,
    "wiener":  { "enabled": true, "window": 5 },
    "median":  { "enabled": false, "window": 2, "padding": "symmetric" },
    "sharpen": { "enabled": false, "radius": 1.05, "amount": 1.6, "threshold": 0.7 }
  },
  "masking": {
    "enabled": true,
    "mode": "manual",
    "global_otsu": { "enabled": false },
    "manual": {
      "enabled": true,
      "threshold": 18500
    },
    "block_otsu": {
      "enabled": false,
      "block_size": 64,
      "border_size": 8,
      "use_parallel": true
    },
    "bradley_adaptive": {
      "enabled": false,
      "window_size": 63,
      "sensitivity": 0.30
    },
    "morphology": {
      "enabled": true,
      "se_type": "disk",
      "close_radius": 100,
      "dilate_radius": 14,
      "open_radius": 3
    }
  },
  "post_mask_preprocess": {
    "enabled": true,
    "wiener":  { "enabled": true, "window": 5 },
    "median":  { "enabled": true, "window": 2, "padding": "symmetric" },
    "sharpen": { "enabled": true, "radius": 1.3, "amount": 1.8, "threshold": 0.9 }
  },
  "hmax_suppression": {
    "enabled": true,
    "h_value": 1200,
    "connectivity": 8
  },
  "regional_max": { "enabled": true, "connectivity": 4, "rescale_before": true },
  "components":   { "enabled": true, "connectivity": 4 },
  "subpixel": { "enabled": true, "method": "2d_gaussian" },
  "tracking": {
    "enabled": true,
    "max_disp": 4.9,
    "skip_frames": 1,
    "remove_nearby_particles": { "enabled": false, "percent_of_max_pixel_displacement": 105 },
    "carry_intensity": true,
    "export_csv": true,
    "export_mat": false
  },
  "intensity": { "enabled": true, "estimator": "mean_5px_cross", "normalize_per_track": true },
  "outputs": {
    "export_centroids_mat": true,
    "export_detection_csv": true,
    "export_figures": true,
    "save_intermediates": false
  }
}